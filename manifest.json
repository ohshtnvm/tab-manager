{
  "manifest_version": 3,
  "name": "Tab Swiper",
  "version": "1.0.0",
  "description": "tab manager that screengrabs and swipes to either keep open, close and bookmark",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Swiper"
  }
}
